{
  "name": "cgv-cli",
  "version": "0.1.0",
  "description": "CGV 예매 플로우(영화 → 영화관 → 날짜 → 상영관별 잔여좌석) TypeScript 클라이언트 + CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "cgv": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeamxn/cgv-cli.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "cli": "tsc -p tsconfig.json && node dist/cli.js",
    "dev": "node --experimental-strip-types src/cli.ts",
    "example": "node --experimental-strip-types examples/full-flow.ts"
  },
  "keywords": [
    "cgv",
    "movie",
    "booking",
    "seats",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
